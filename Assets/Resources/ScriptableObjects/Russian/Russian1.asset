      correctAnswerIndex: 0
    - questions: "\u0427\u0442\u043E \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B
        \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430
