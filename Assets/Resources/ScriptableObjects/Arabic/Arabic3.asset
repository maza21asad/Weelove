      answers: "\u062C. \u0644\u0636\u0645\u0627\u0646 \u0648\u0642\u062A \u0627\u0633\u062A\u062C\u0627\u0628\u0629
        \u0643\u0627\u0641\u064D "
    - questions: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0633\u0631\u0639\u0629
