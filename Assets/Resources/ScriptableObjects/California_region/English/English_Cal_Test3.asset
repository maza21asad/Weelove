      answers: 'A) When visibility is less than 1,000 feet   '
      correctAnswerIndex: 0
    - questions: 'An orange sign typically indicates: '
      emogis: []
      options:
      - 'A) Regulatory instructions   '
      - 'B) Construction or maintenance area   '
      - 'C) General warning   '
      answers: 'B) Construction or maintenance area   '
      correctAnswerIndex: 1
    - questions: 'Before making a lane change, you must:   '
