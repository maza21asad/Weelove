      answers: "\u0628. \u0627\u0644\u0639\u0628\u0648\u0631 \u0628\u062D\u0630\u0631
        \u0648\u0627\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0641\u0629 "
    - questions: "\u0645\u0627 \u0645\u0639\u0646\u0649 \u0639\u0644\u0627\u0645\u0629
