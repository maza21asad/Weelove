%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8231245e4999eb498c6af83841371fe, type: 3}
  m_Name: QuesData 2
  m_EditorClassIdentifier: 
  tests:
  - testsName: Test 2
    quesAnswers:
    - questions: What should you do when approaching an intersection with a "Yield"
        sign?
      emogis: []
      options:
      - Slow down and continue if there is no traffic
      - Always stop
      - Yield to the vehicle approaching from the blocked direction
      - Yield to any vehicle approaching the intersection
      answers: Yield to any vehicle approaching the intersection
    - questions: What is the correct way to drive when approaching a railway crossing
        without a barrier?
      emogis: []
      options:
      - Slow down, look both ways, and proceed with caution
      - Always stop
      - Accelerate to pass quickly
      - Honk to warn the train
      answers: Slow down, look both ways, and proceed with caution
    - questions: What does a "No Parking" sign mean?
      emogis: []
      options:
      - Parking is allowed only at night
      - Parking is allowed only during the day
      - No parking is allowed at any time
      - Parking is allowed if there is no additional sign
      answers: No parking is allowed at any time
    - questions: What is the correct way to drive when approaching a school?
      emogis: []
      options:
      - Slow down and be prepared to stop
      - Accelerate to avoid disturbing
      - Honk to warn children
      - Drive in the left lane
      answers: Slow down and be prepared to stop
    - questions: What is the danger of driving too slowly?
      emogis: []
      options:
      - There is no danger at all
      - It may cause dangerous overtaking
      - It saves fuel
      - It improves reaction time
      answers: It may cause dangerous overtaking
    - questions: What is the correct way to drive when approaching a parked vehicle
        on the side of the road?
      emogis: []
      options:
      - Accelerate and pass quickly
      - Pass as closely as possible
      - Keep a distance and pass carefully
      - Honk to warn the driver
      answers: Keep a distance and pass carefully
    - questions: What does a "No Entry for Bicycles" sign mean?
      emogis: []
      options:
      - Bicycles are allowed only at night
      - Bicycles are allowed if there are no vehicles
      - Bicycles are not allowed in this area
      - Bicycles are allowed if there is a path
      answers: Bicycles are not allowed in this area
    - questions: What is the correct way to drive when approaching an intersection
        with a flashing yellow traffic light?
      emogis: []
      options:
      - Always stop
      - Slow down and drive carefully
      - Accelerate to pass quickly
      - Ignore the traffic light
      answers: Slow down and drive carefully
    - questions: What is the correct way to drive when approaching a vehicle signaling
        to overtake?
      emogis: []
      options:
      - Accelerate to prevent overtaking
      - Slow down and allow it to overtake
      - Move to the left lane
      - Honk to warn
      answers: Slow down and allow it to overtake
    - questions: ' What does a "No Entry for Heavy Vehicles" sign mean?'
      emogis: []
      options:
      - Private vehicles are allowed only
      - Two-wheeled vehicles are allowed only
      - Vehicles weighing above the limit are not allowed
      - Public vehicles are allowed only
      answers: Vehicles weighing above the limit are not allowed
    - questions: ' What is the correct way to drive when approaching an intersection
        with a "Stop" sign?'
      emogis: []
      options:
      - Slow down and proceed carefully
      - Stop only if there is traffic
      - Come to a complete stop and yield
      - Accelerate to avoid disturbing
      answers: Come to a complete stop and yield
    - questions: ' What does a "No Entry for Two-Wheeled Vehicles" sign mean?'
      emogis: []
      options:
      - Only two-wheeled vehicles are allowed
      - Two-wheeled vehicles are not allowed to enter
      - Two-wheeled vehicles are allowed if there is no additional sign
      - Two-wheeled vehicles are allowed only at night
      answers: Two-wheeled vehicles are not allowed to enter
    - questions: ' What is the correct way to drive when approaching a vehicle signaling
        to turn left?'
      emogis: []
      options:
      - Overtake it on the right carefully
      - Overtake it on the left
      - Accelerate and pass in front of it
      - Honk to warn
      answers: Overtake it on the right carefully
    - questions: ' What does a "No Entry for Vehicles with Trailers" sign mean?'
      emogis: []
      options:
      - Light trailers are allowed
      - Vehicles with trailers are not allowed to enter
      - Only commercial vehicles are allowed
      - Allowed if the trailer is empty
      answers: Vehicles with trailers are not allowed to enter
    - questions: ' What is the correct way to drive when approaching a hidden crosswalk?'
      emogis: []
      options:
      - Slow down and be prepared to stop
      - Accelerate to pass quickly
      - Honk to warn
      - Drive in the left lane
      answers: Slow down and be prepared to stop
    - questions: ' What does a "No Entry for Public Vehicles" sign mean?'
      emogis: []
      options:
      - Only private vehicles are allowed
      - Public vehicles are allowed at night
      - Public vehicles are allowed if there is no additional sign
      - Public vehicles are allowed with permission
      answers: Only private vehicles are allowed
    - questions: ' What is the correct way to drive when approaching a parked vehicle
        with an open door?'
      emogis: []
      options:
      - Pass as closely as possible
      - Slow down and pass carefully
      - Honk to warn
      - Accelerate and pass quickly
      answers: Slow down and pass carefully
    - questions: ' What does a "No Entry for Vehicles with Hazardous Materials" sign
        mean?'
      emogis: []
      options:
      - Vehicles with fuel are allowed only
      - Vehicles with hazardous materials are not allowed to enter
      - Vehicles with special permission are allowed
      - Allowed only at night
      answers: Vehicles with hazardous materials are not allowed to enter
    - questions: ' What is the correct way to drive when approaching an intersection
        with a "Roundabout" sign?'
      emogis: []
      options:
      - Enter quickly
      - Always stop
      - Enter carefully and yield
      - Enter only if there is no vehicle on the right
      answers: Enter carefully and yield
    - questions: ' What does a "No Entry for Vehicles Above a Certain Height" sign
        mean?'
      emogis: []
      options:
      - Tall vehicles are allowed if there is no additional sign
      - Vehicles taller than the limit are not allowed to enter
      - Public vehicles only
      - Allowed with a police escort
      answers: Vehicles taller than the limit are not allowed to enter
    - questions: ' What is the correct way to drive when approaching a vehicle signaling
        to exit a parking space?'
      emogis: []
      options:
      - Accelerate and pass in front of it
      - Stop and let it exit
      - Honk to warn
      - Pass in the opposite lane
      answers: Stop and let it exit
    - questions: ' What does a "No Entry for Vehicles Over a Certain Weight" sign
        mean?'
      emogis: []
      options:
      - Heavy vehicles are allowed if there is no additional sign
      - Vehicles weighing above the limit are not allowed to enter
      - Public vehicles only
      - Allowed only at night
      answers: Vehicles weighing above the limit are not allowed to enter
    - questions: ' What is the correct way to drive when approaching an intersection
        with a "One-Way Traffic" sign?'
      emogis: []
      options:
      - Drive only in the direction of the arrow
      - Allowed to drive in any direction
      - Allowed to turn left only
      - Allowed to turn right only
      answers: Drive only in the direction of the arrow
    - questions: ' What does a "No Entry for Vehicles with Oversized Loads" sign
        mean?'
      emogis: []
      options:
      - Allowed if the load is secured well
      - Vehicles with loads exceeding the limit are not allowed to enter
      - Allowed if there is an escort
      - Allowed only during the day
      answers: Vehicles with loads exceeding the limit are not allowed to enter
    - questions: ' What is the correct way to drive when approaching a vehicle signaling
        to turn right?'
      emogis: []
      options:
      - Overtake it on the left carefully
      - Overtake it on the right
      - Accelerate and pass in front of it
      - Stop behind it
      answers: Overtake it on the left carefully
    - questions: ' What does a "No Entry for Vehicles with Flammable Cargo" sign
        mean?'
      emogis: []
      options:
      - Allowed for vehicles with flammable cargo if there is permission
      - Vehicles with flammable cargo are not allowed to enter
      - Allowed with an escort
      - Allowed only at night
      answers: Vehicles with flammable cargo are not allowed to enter
    - questions: ' What is the correct way to drive when approaching an intersection
        with a "Traffic Light Ahead" sign?'
      emogis: []
      options:
      - Slow down and prepare to stop
      - Accelerate to make it
      - Stop immediately
      - Ignore the traffic light
      answers: Slow down and prepare to stop
    - questions: ' What does a "No Entry for Vehicles with Explosive Cargo" sign
        mean?'
      emogis: []
      options:
      - Allowed if the cargo is secured
      - Vehicles with explosive cargo are not allowed to enter
      - Allowed with police escort
      - Allowed only during the day
      answers: Vehicles with explosive cargo are not allowed to enter
    - questions: ' What is the correct way to drive when approaching a vehicle signaling
        to turn left at an intersection?'
      emogis: []
      options:
      - Overtake it on the right carefully
      - Overtake it on the left
      - Accelerate and pass in front of it
      - Stop behind it
      answers: Overtake it on the right carefully
    - questions: ' What does a "No Entry for Vehicles with Toxic Cargo" sign mean?'
      emogis: []
      options:
      - Allowed if the cargo is closed
      - Vehicles with toxic cargo are not allowed to enter
      - Allowed with another vehicle escort
      - Allowed only at night
      answers: Vehicles with toxic cargo are not allowed to enter
