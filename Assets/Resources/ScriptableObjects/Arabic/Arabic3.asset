  tests:
  - testsName: Test 3
    quesAnswers:
    - questions: "\u0645\u0627\u0630\u0627 \u064A\u062C\u0628 \u0623\u0646 \u062A\u0641\u0639\u0644
        \u0639\u0646\u062F\u0645\u0627 \u062A\u0633\u0645\u0639 \u0633\u064A\u0627\u0631\u0629
        \u0637\u0648\u0627\u0631\u0626 \u062A\u0642\u062A\u0631\u0628 \u0645\u0646
        \u0627\u0644\u062E\u0644\u0641 \u0645\u0639 \u0623\u0636\u0648\u0627\u0621
        \u0648\u0635\u0641\u0627\u0631\u0629\u061F "
      emogis: []
      options:
      - "\u0623. \u0627\u0644\u062A\u0648\u0642\u0641 \u0641\u0648\u0631\u0627\u064B
        \u0641\u064A \u0645\u0646\u062A\u0635\u0641 \u0627\u0644\u0637\u0631\u064A\u0642 "
      - "\u0628. \u0627\u0644\u062A\u0628\u0627\u0637\u0624 \u0648\u0627\u0644\u0627\u0633\u062A\u0645\u0631\u0627\u0631 "
      - "\u062C. \u0627\u0644\u0627\u0644\u062A\u0635\u0627\u0642 \u0628\u0627\u0644\u064A\u0645\u064A\u0646
        \u0648\u0625\u0641\u0633\u0627\u062D \u0627\u0644\u0645\u062C\u0627\u0644 "
      - "\u062F. \u0627\u0644\u0627\u0646\u062A\u0642\u0627\u0644 \u0625\u0644\u0649
        \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0623\u064A\u0633\u0631 "
      answers: "\u062C. \u0627\u0644\u0627\u0644\u062A\u0635\u0627\u0642 \u0628\u0627\u0644\u064A\u0645\u064A\u0646
        \u0648\u0625\u0641\u0633\u0627\u062D \u0627\u0644\u0645\u062C\u0627\u0644 "
    - questions: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0637\u0631\u064A\u0642\u0629
        \u0627\u0644\u0623\u0643\u062B\u0631 \u0623\u0645\u0627\u0646\u0627\u064B
        \u0644\u0639\u0628\u0648\u0631 \u062A\u0642\u0627\u0637\u0639 \u0628\u0625\u0634\u0627\u0631\u0629
        \u0645\u0631\u0648\u0631\u061F "
      emogis: []
      options:
      - "\u0623. \u0627\u0644\u062A\u0633\u0627\u0631\u0639 \u062D\u062A\u0649 \u0644\u0627
        \u062A\u062A\u0639\u0637\u0644 \u0639\u0646\u062F \u0627\u0644\u0625\u0634\u0627\u0631\u0629
        \u0627\u0644\u062D\u0645\u0631\u0627\u0621 "
      - "\u0628. \u0627\u0644\u062A\u0628\u0627\u0637\u0624 \u0648\u0627\u0644\u062A\u0648\u0642\u0641
        \u062F\u0627\u0626\u0645\u0627\u064B "
      - "\u062C. \u0641\u062D\u0635 \u062D\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0648\u0631
        \u0648\u0627\u0644\u0627\u0645\u062A\u062B\u0627\u0644 \u0644\u0625\u0634\u0627\u0631\u0629
        \u0627\u0644\u0645\u0631\u0648\u0631 "
      - "\u062F. \u0627\u0644\u062A\u0632\u0645\u064A\u0631 \u0642\u0628\u0644 \u0627\u0644\u062A\u0642\u0627\u0637\u0639 "
      answers: "\u062C. \u0641\u062D\u0635 \u062D\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0648\u0631
        \u0648\u0627\u0644\u0627\u0645\u062A\u062B\u0627\u0644 \u0644\u0625\u0634\u0627\u0631\u0629
        \u0627\u0644\u0645\u0631\u0648\u0631 "
    - questions: "\u0645\u0627 \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0631\u0626\u064A\u0633\u064A
        \u0644\u0644\u062D\u0641\u0627\u0638 \u0639\u0644\u0649 \u0645\u0633\u0627\u0641\u0629
        \u0645\u0646 \u0627\u0644\u0633\u064A\u0627\u0631\u0629 \u0623\u0645\u0627\u0645\u0643\u061F "
      emogis: []
      options:
      - "\u0623. \u0644\u062A\u062D\u0633\u064A\u0646 \u0633\u0631\u0639\u0629 \u0627\u0644\u0642\u064A\u0627\u062F\u0629 "
