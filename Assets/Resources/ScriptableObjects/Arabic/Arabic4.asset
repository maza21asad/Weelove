  - testsName: Test 4
    quesAnswers:
    - questions: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0637\u0631\u064A\u0642\u0629
        \u0627\u0644\u0635\u062D\u064A\u062D\u0629 \u0644\u0644\u062A\u0635\u0631\u0641
        \u0639\u0646\u062F \u0627\u0644\u0627\u0642\u062A\u0631\u0627\u0628 \u0645\u0646
        \u0645\u0639\u0628\u0631 \u0645\u0634\u0627\u0629 \u0645\u0628\u0644\u0644
        \u062A\u062D\u062A \u0627\u0644\u0645\u0637\u0631\u061F "
      emogis: []
      options:
      - "\u0623. \u0627\u0644\u062A\u0633\u0627\u0631\u0639 \u0644\u062A\u062C\u0646\u0628
        \u0627\u0644\u062A\u0648\u0642\u0641 "
      - "\u0628. \u0627\u0644\u062A\u0628\u0627\u0637\u0624 \u0648\u0627\u0644\u0627\u0633\u062A\u0639\u062F\u0627\u062F
        \u0644\u0644\u062A\u0648\u0642\u0641 "
      - "\u062C. \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0628\u0648\u0642
        \u0644\u062A\u062D\u0630\u064A\u0631 \u0627\u0644\u0645\u0634\u0627\u0629 "
      - "\u062F. \u0627\u0644\u0642\u064A\u0627\u062F\u0629 \u0641\u064A \u0627\u0644\u0645\u0633\u0627\u0631
        \u0627\u0644\u0623\u064A\u0633\u0631 "
      answers: "\u0628. \u0627\u0644\u062A\u0628\u0627\u0637\u0624 \u0648\u0627\u0644\u0627\u0633\u062A\u0639\u062F\u0627\u062F
        \u0644\u0644\u062A\u0648\u0642\u0641 "
    - questions: "\u0645\u0627 \u0645\u0639\u0646\u0649 \u0639\u0644\u0627\u0645\u0629
        \"\u0645\u0645\u0646\u0648\u0639 \u0627\u0644\u062F\u062E\u0648\u0644 \u0644\u0644\u0645\u0631\u0643\u0628\u0627\u062A
        \u0627\u0644\u0645\u062D\u0645\u0644\u0629 \u0628\u0645\u0648\u0627\u062F
        \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062A\u0639\u0627\u0644\"\u061F "
      emogis: []
      options:
      - "\u0623. \u0645\u0633\u0645\u0648\u062D \u0625\u0630\u0627 \u0643\u0627\u0646\u062A
        \u0627\u0644\u062D\u0645\u0648\u0644\u0629 \u0645\u063A\u0644\u0642\u0629 "
      - "\u0628. \u0645\u0633\u0645\u0648\u062D \u0628\u0631\u0641\u0642\u0629 \u0645\u0631\u0643\u0628\u0629
        \u0623\u062E\u0631\u0649 "
      - "\u062C. \u0645\u0645\u0646\u0648\u0639 \u062F\u062E\u0648\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062A
        \u0627\u0644\u0645\u062D\u0645\u0644\u0629 \u0628\u0645\u0648\u0627\u062F
        \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062A\u0639\u0627\u0644 "
      - "\u062F. \u0645\u0633\u0645\u0648\u062D \u0641\u0642\u0637 \u062E\u0644\u0627\u0644
        \u0633\u0627\u0639\u0627\u062A \u0627\u0644\u0646\u0647\u0627\u0631 "
      answers: "\u062C. \u0645\u0645\u0646\u0648\u0639 \u062F\u062E\u0648\u0644 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062A
        \u0627\u0644\u0645\u062D\u0645\u0644\u0629 \u0628\u0645\u0648\u0627\u062F
        \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062A\u0639\u0627\u0644 "
    - questions: "\u0643\u064A\u0641 \u064A\u062C\u0628 \u0623\u0646 \u062A\u0642\u0648\u062F
        \u0639\u0646\u062F \u0627\u0644\u0627\u0642\u062A\u0631\u0627\u0628 \u0645\u0646
        \u062A\u0642\u0627\u0637\u0639 \u0645\u0639 \u0639\u0644\u0627\u0645\u0629
        \"\u0642\u0641\" \u0648\u0644\u0643\u0646 \u0644\u0627 \u062A\u0648\u062C\u062F
        \u062D\u0631\u0643\u0629\u061F "
      emogis: []
      options:
      - "\u0623. \u0627\u0644\u062A\u0628\u0627\u0637\u0624 \u0648\u0627\u0644\u0627\u0633\u062A\u0645\u0631\u0627\u0631 "
      - "\u0628. \u0627\u0644\u062A\u0648\u0642\u0641 \u062A\u0645\u0627\u0645\u064B\u0627
        \u0648\u0645\u0646\u062D \u0627\u0644\u0623\u0641\u0636\u0644\u064A\u0629 "
      - "\u062C. \u0627\u0644\u062A\u0633\u0627\u0631\u0639 \u0648\u0627\u0644\u0639\u0628\u0648\u0631 "
      - "\u062F. \u0627\u0633\u062A\u062E\u062F\u0627\u0645 \u0627\u0644\u0628\u0648\u0642
        \u0648\u0627\u0644\u062F\u062E\u0648\u0644 "
      answers: "\u0628. \u0627\u0644\u062A\u0648\u0642\u0641 \u062A\u0645\u0627\u0645\u064B\u0627
        \u0648\u0645\u0646\u062D \u0627\u0644\u0623\u0641\u0636\u0644\u064A\u0629 "
    - questions: "\u0645\u0627 \u0647\u064A \u0627\u0644\u0637\u0631\u064A\u0642\u0629
